# ===================================================
# Apartment Manager — Environment Variables Template
# ===================================================

# --- Supabase Database & Auth (Required) ---
# Your Supabase Project URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Public Anon Key (found in Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- iCal Calendar Integration (Optional) ---
# Predefined external .ics calendar feed URLs
VITE_AIRBNB_ICAL_URL=https://www.airbnb.com/calendar/ical/your-listing-id.ics?s=your-token
VITE_BOOKING_ICAL_URL=https://admin.booking.com/hotel/hoteladmin/ical.html?t=your-token

# --- Serverless Proxy Security Key (Optional) ---
# If configured, requests to /api/ical must provide this key in the 'x-api-key' header
ICAL_PROXY_API_KEY=your-secure-proxy-api-key
VITE_ICAL_PROXY_API_KEY=your-secure-proxy-api-key
